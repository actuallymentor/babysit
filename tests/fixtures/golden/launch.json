  "build_launch_yaml": [
    "# How the session starts. `babysit --config DIR/` starts one session per yaml in\n# DIR and needs only agent; commented keys show their defaults. A bare\n# `babysit --config FILE` opens the launch menu with these values.\nlaunch:\n    # claude | codex | opencode\n    agent: claude\n\n    # Directory launches default to the yaml path relative to DIR.\n    # name: my session\n\n    # regular | sandbox | mudbox; clone needs regular.\n    # mode: regular\n\n    # yolo: false\n    # Mounts the host Docker socket (sibling containers); agents always run in a container.\n    # docker: false\n    # Android device access (adb), iPhone access (ios, iOS 16 and older); devices turns on every kind.\n    # adb: false\n    # ios: false\n    # devices: false\n    # clone: false\n    # loop: false\n    # ignore_host_agents_md: false\n\n    # PORT or HOST:CONTAINER entries.\n    # ports: []\n\n    # false, true for the default path, or a file path.\n    # log: false\n\n    # Passed to the agent CLI as-is, e.g. [\"--model\", \"opus\"].\n    # args: []\n",
    "# How the session starts. `babysit --config DIR/` starts one session per yaml in\n# DIR and needs only agent; commented keys show their defaults. A bare\n# `babysit --config FILE` opens the launch menu with these values.\nlaunch:\n    # claude | codex | opencode\n    agent: claude\n\n    # Directory launches default to the yaml path relative to DIR.\n    # name: my session\n\n    # regular | sandbox | mudbox; clone needs regular.\n    # mode: regular\n\n    yolo: true\n    # Mounts the host Docker socket (sibling containers); agents always run in a container.\n    docker: true\n    # Android device access (adb), iPhone access (ios, iOS 16 and older); devices turns on every kind.\n    adb: true\n    ios: true\n    devices: true\n    clone: true\n    loop: true\n    ignore_host_agents_md: true\n\n    # PORT or HOST:CONTAINER entries.\n    ports: [\"3000\", \"8080:80\"]\n\n    # false, true for the default path, or a file path.\n    log: true\n\n    # Passed to the agent CLI as-is, e.g. [\"--model\", \"opus\"].\n    # args: []\n",
    "# How the session starts. `babysit --config DIR/` starts one session per yaml in\n# DIR and needs only agent; commented keys show their defaults. A bare\n# `babysit --config FILE` opens the launch menu with these values.\nlaunch:\n    # claude | codex | opencode\n    agent: codex\n\n    # Directory launches default to the yaml path relative to DIR.\n    # name: my session\n\n    # regular | sandbox | mudbox; clone needs regular.\n    mode: sandbox\n\n    # yolo: false\n    # Mounts the host Docker socket (sibling containers); agents always run in a container.\n    # docker: false\n    # Android device access (adb), iPhone access (ios, iOS 16 and older); devices turns on every kind.\n    # adb: false\n    # ios: false\n    # devices: false\n    # clone: false\n    # loop: false\n    # ignore_host_agents_md: false\n\n    # PORT or HOST:CONTAINER entries.\n    # ports: []\n\n    # false, true for the default path, or a file path.\n    log: \"out.log\"\n\n    # Passed to the agent CLI as-is, e.g. [\"--model\", \"opus\"].\n    args: [\"--model\", \"o3\"]\n",
    "# How the session starts. `babysit --config DIR/` starts one session per yaml in\n# DIR and needs only agent; commented keys show their defaults. A bare\n# `babysit --config FILE` opens the launch menu with these values.\nlaunch:\n    # claude | codex | opencode\n    agent: claude\n\n    # Directory launches default to the yaml path relative to DIR.\n    name: \"x\"\n\n    # regular | sandbox | mudbox; clone needs regular.\n    mode: mudbox\n\n    # yolo: false\n    # Mounts the host Docker socket (sibling containers); agents always run in a container.\n    # docker: false\n    # Android device access (adb), iPhone access (ios, iOS 16 and older); devices turns on every kind.\n    # adb: false\n    ios: true\n    # devices: false\n    # clone: false\n    # loop: false\n    # ignore_host_agents_md: false\n\n    # PORT or HOST:CONTAINER entries.\n    # ports: []\n\n    # false, true for the default path, or a file path.\n    # log: false\n\n    # Passed to the agent CLI as-is, e.g. [\"--model\", \"opus\"].\n    # args: []\n"
  ],
